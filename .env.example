T212_ENV=live
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here

# Public HTTPS URL this server is reachable at (no trailing slash), e.g. https://mcp.example.com
MCP_PUBLIC_URL=https://mcp.example.com
# Bare domain (no scheme) Caddy should request a TLS cert for; must match MCP_PUBLIC_URL's host
MCP_DOMAIN=mcp.example.com
# Password required to approve the OAuth login when Claude connects
MCP_AUTH_PASSWORD=change_me

# Optional: bind address / port (defaults shown)
HOST=0.0.0.0
PORT=8000
