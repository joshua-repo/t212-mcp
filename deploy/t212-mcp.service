[Unit]
Description=t212-mcp MCP server
After=network.target

[Service]
Type=simple
User=t212mcp
Group=t212mcp
WorkingDirectory=/opt/t212-mcp
EnvironmentFile=/opt/t212-mcp/.env
ExecStart=/opt/t212-mcp/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/t212-mcp

[Install]
WantedBy=multi-user.target
