# Drop into /etc/nginx/sites-available/t212-mcp, symlink into sites-enabled,
# then: sudo certbot --nginx -d mcp.example.com
# (certbot rewrites the listen/ssl_certificate lines for you on first run)

server {
    listen 80;
    server_name mcp.example.com;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # streamable-http keeps a long-lived text/event-stream response open;
        # don't let nginx buffer or time it out.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
